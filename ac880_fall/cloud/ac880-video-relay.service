[Unit]
Description=AC880 single-upstream video fanout
After=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 /opt/ac880-home-preview/video_relay.py
Restart=on-failure
RestartSec=3
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
