[Unit]
Description=AC880 private authenticated web preview
After=network.target

[Service]
Type=simple
ExecStartPre=/usr/sbin/nginx -t -c /opt/ac880-home-preview/nginx.conf
ExecStart=/usr/sbin/nginx -c /opt/ac880-home-preview/nginx.conf -g "daemon off;"
ExecReload=/usr/sbin/nginx -c /opt/ac880-home-preview/nginx.conf -s reload
KillSignal=SIGQUIT
TimeoutStopSec=15
Restart=on-failure
RestartSec=3
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
